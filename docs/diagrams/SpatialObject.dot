	SpatialObject -> SpatialObject [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">rcc8dc</TD></TR></TABLE>> arrowhead=normal style=solid]
	SpatialObject -> SpatialObject [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">rcc8ec</TD></TR></TABLE>> arrowhead=normal style=solid]
