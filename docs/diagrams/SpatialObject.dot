	SpatialObject -> SpatialObject [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">rcc8ntpp</TD></TR></TABLE>> arrowhead=normal style=solid]
	SpatialObject -> SpatialObject [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">rcc8ntppi</TD></TR></TABLE>> arrowhead=normal style=solid]
	SpatialObject -> SpatialObject [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">rcc8po</TD></TR></TABLE>> arrowhead=normal style=solid]
	SpatialObject -> SpatialObject [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD ALIGN="CENTER">rcc8tpp</TD></TR></TABLE>> arrowhead=normal style=solid]
