  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#defaultGeometry">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.2.1"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <schema:name xml:lang="en">default geometry</schema:name>
    <skos:note xml:lang="en">Duplicate properties defaultGeometry and hasDefaultGeometry exist because of an inconsistency between ontology and documentation in GeoSPARQL 1.0. Only hasDefaultGeometry is described in the documention.</skos:note>
