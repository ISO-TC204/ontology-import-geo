  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#asGeoJSON">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.4"/>
    <schema:name xml:lang="en">as GeoJSON</schema:name>
    <schema:description xml:lang="en">The GeoJSON serialization of a Geometry</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-geojson-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:seeAlso rdf:resource="https://tools.ietf.org/html/rfc7946"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#geoJSONLiteral"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasSerialization"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#1.1">
    <schema:name>1.1</schema:name>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.4"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.3"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.3.3"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/feature-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties"/>
    <schema:description xml:lang="en">A spatial representation for a given Feature.</schema:description>
    <schema:name xml:lang="en">has geometry</schema:name>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.3"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.4"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.5"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.6"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.8"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.3.2"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#dggsLiteral">
    <skos:scopeNote xml:lang="en">This datatype is not expected to be used directly but to serve as an abstract datatype for a series of specific DGGS literal types, for specific DGGS implementations</skos:scopeNote>
    <schema:name xml:lang="en">DGGS Literal</schema:name>
    <rdfs:seeAlso rdf:resource="http://www.opengis.net/doc/AS/dggs/2.0"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#c-1-2-4-%C2%A0-geometry-serializations"/>
    <skos:example> "&lt;https://w3id.org/dggs/auspix&gt; OrdinateList (R3234)"^^&lt;http://www.opengis.net/ont/geosparql#dggsLiteral&gt;</skos:example>
    <schema:description xml:lang="en">A textual serialization of a Discrete Global Grid (DGGS) Geometry object.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/dggs-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasSpatialResolution">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <schema:name xml:lang="en">has spatial resolution</schema:name>
    <skos:note xml:lang="en">Spatial resolution specifies the level of detail of a Geometry. It the smallest distinguishable distance between spatially adjacent coordinates.</skos:note>
    <schema:description xml:lang="en">The spatial resolution of a Geometry.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasLength">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.7"/>
    <schema:name xml:lang="en">has length</schema:name>
    <schema:description xml:lang="en">The length of a Spatial Object.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasSize"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#dimension">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.3"/>
    <schema:name xml:lang="en">dimension</schema:name>
    <schema:description xml:lang="en">The topological dimension of this geometric object, which must be less than or equal to the coordinate dimension. In non-homogeneous collections, this will return the largest topological dimension of the contained objects.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasSpatialAccuracy">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.3"/>
    <schema:name xml:lang="en">has spatial accuracy</schema:name>
    <skos:note xml:lang="en">Spatial accuracy is applicable when a Geometry is used to represent a Feature. It is expressed as a distance that indicates the truthfullness of the positions (coordinates) that define the Geometry. In this case accuracy defines a zone surrounding each coordinate within wich the real positions are known to be. The accuracy value defines this zone as a distance from the coordinate(s) in all directions (e.g. a line, a circle or a sphere, depending on spatial dimension).</skos:note>
    <schema:description xml:lang="en">The positional accuracy of the coordinates of a Geometry.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasMetricLength">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <schema:name xml:lang="en">has length in meters</schema:name>
    <schema:description xml:lang="en">The length of a Spatial Object in meters.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasMetricSize"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#ehCovers">
    <schema:name xml:lang="en">covers</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially covers the object SpatialObject. DE-9IM: T*TFT*FF*</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasMetricSize">
    <schema:name xml:lang="en">has metric size</schema:name>
    <schema:description xml:lang="en">Subproperties of this property are used to indicate the size of a Spatial Object, as a measurement or estimate of one or more dimensions of the Spatial Object's spatial presence. Units are always metric (meter, square meter or cubic meter).</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#SpatialObject">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.1.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.1.1"/>
    <schema:name xml:lang="en">Spatial Object</schema:name>
    <skos:note xml:lang="en">Subclasses of this class are expected to be used for instance data.</skos:note>
    <schema:description xml:lang="en">Anything spatial (being or having a shape, position or an extent).</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/core/spatial-object-class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/core/spatial-object-class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasMetricSpatialResolution">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.6"/>
    <schema:name xml:lang="en">has spatial resolution in meters</schema:name>
    <skos:note xml:lang="en">Spatial resolution specifies the level of detail of a Geometry. It the smallest dinstinguishable distance between spatially adjacent coordinates.</skos:note>
    <schema:description xml:lang="en">The spatial resolution of a Geometry in meters.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasMetricArea">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.3.3"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.9"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.3"/>
    <schema:name xml:lang="en">has area in square meters</schema:name>
    <schema:description xml:lang="en">The area of a Spatial Object in square meters.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasMetricSize"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#isEmpty">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.3"/>
    <schema:name xml:lang="en">is empty</schema:name>
    <schema:description xml:lang="en">(true) if this geometric object is the empty Geometry. If true, then this geometric object represents the empty point set for the coordinate space.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasSerialization">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.3"/>
    <schema:name xml:lang="en">has serialization</schema:name>
    <schema:description xml:lang="en">Connects a Geometry object with its text-based serialization.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#ehInside">
    <schema:name xml:lang="en">inside</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject is spatially inside the object SpatialObject. DE-9IM: TFF*FFT**</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasPerimeterLength">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.1.2"/>
    <schema:name xml:lang="en">has perimeter length</schema:name>
    <schema:description xml:lang="en">The length of the perimeter of a Spatial Object.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasSize"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#ehOverlap">
    <schema:name xml:lang="en">overlap</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially overlaps the object SpatialObject. DE-9IM: T*T***T**</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#rcc8ec">
    <schema:name xml:lang="en">externally connected</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially meets the object SpatialObject. DE-9IM: FFTFTTTTT</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasCentroid">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <skos:scopeNote xml:lang="en">The target Geometry shall describe a point, for example an instance of http://www.opengis.net/ont/sf#Point.</skos:scopeNote>
    <schema:name xml:lang="en">has centroid</schema:name>
    <schema:description xml:lang="en">The arithmetic mean position of all the Geometry points of a given Feature.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasMetricPerimeterLength">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.1.2"/>
    <schema:name xml:lang="en">has perimeter length in meters</schema:name>
    <schema:description xml:lang="en">The length of the perimeter of a Spatial Object in meters.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/spatial-object-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasMetricSize"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#coordinateDimension">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.3"/>
    <schema:name xml:lang="en">coordinate dimension</schema:name>
    <schema:description xml:lang="en">The number of measurements or axes needed to describe the position of this Geometry in a coordinate system.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#rcc8tppi">
    <schema:name xml:lang="en">tangential proper part inverse</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially covers the object SpatialObject. DE-9IM: TTTFTTFFT</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#sfIntersects">
    <schema:name xml:lang="en">intersects</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject is not spatially disjoint from the object SpatialObject. DE-9IM: T******** ^ *T******* ^ ***T***** ^ ****T****</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#asWKT">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.2.1"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.2.2.4"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.3.3"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.3.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.3.1"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasSerialization"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#wktLiteral"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-as-wkt-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-wkt-literal"/>
    <schema:description xml:lang="en">The WKT serialization of a Geometry</schema:description>
    <schema:name xml:lang="en">as WKT</schema:name>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.2"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.3"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.4"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.5"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.6"/>
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.2.8"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#isSimple">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.3"/>
    <schema:name xml:lang="en">is simple</schema:name>
    <rdfs:seeAlso rdf:resource="https://portal.ogc.org/files/?artifact_id=25355"/>
    <schema:description xml:lang="en">(true) if this geometric object has no anomalous geometric points, such as self intersection or self tangency.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasSize">
    <schema:name xml:lang="en">has size</schema:name>
    <skos:note xml:lang="en">The recommended way to specify size is by using a subproperty of hasMetricSize. Subproperties of hasSize can be used if more complex expressions are necessary, for example if the unit of length can not be converted to meter, or if additional data are needed to describe the measurement or estimate.</skos:note>
    <schema:description xml:lang="en">Subproperties of this property are used to indicate the size of a Spatial Object as a measurement or estimate of one or more dimensions of the Spatial Object's spatial presence.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/spatial-object-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/spatial-object-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasMetricSpatialAccuracy">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.3"/>
    <schema:name xml:lang="en">has spatial accuracy in meters</schema:name>
    <skos:note xml:lang="en">Spatial accuracy is applicable when a Geometry is used to represent a Feature. It is expressed as a distance that indicates the truthfullness of the positions (coordinates) that define the Geometry. In this case accuracy defines a zone surrounding each coordinate within wich the real positions are known to be. The accuracy value defines this zone as a distance from the coordinate(s) in all directions (e.g. a line, a circle or a sphere, depending on spatial dimension).</skos:note>
    <schema:description xml:lang="en">The positional accuracy of the coordinates of a Geometry in meters.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#rcc8eq">
    <schema:name xml:lang="en">equals</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially equals the object SpatialObject. DE-9IM: TFFFTFFFT</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#kmlLiteral">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#c-1-2-4-%C2%A0-geometry-serializations"/>
    <schema:name xml:lang="en">KML Literal</schema:name>
    <schema:description xml:lang="en">A KML serialization of a Geometry object.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/kml-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:seeAlso rdf:resource="https://www.ogc.org/standards/kml/"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#rcc8ntppi">
    <schema:name xml:lang="en">non-tangential proper part inverse</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially contains the object SpatialObject. DE-9IM: TTTFFTFFT</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#hasBoundingBox">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.2"/>
    <skos:scopeNote xml:lang="en">The target is a Geometry that defines a rectilinear region whose edges are aligned with the axes of the coordinate reference system, which exactly contains the Feature, for example an instance of http://www.opengis.net/ont/sf#envelope.</skos:scopeNote>
    <schema:name xml:lang="en">has bounding box</schema:name>
    <schema:description xml:lang="en">The minimum or smallest bounding or enclosing box of a given Feature.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/feature-properties"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdfs:subPropertyOf rdf:resource="http://www.opengis.net/ont/geosparql#hasGeometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#rcc8tpp">
    <schema:name xml:lang="en">tangential proper part</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject is spatially covered by the object SpatialObject. DE-9IM: TFFTTFTTT</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A2">
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#member"/>
    <owl:allValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#ehContains">
    <schema:name xml:lang="en">contains</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially contains the object SpatialObject. DE-9IM: T*TFF*FF*</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#sfCrosses">
    <schema:name xml:lang="en">crosses</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially crosses the object SpatialObject. DE-9IM: T*T******</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#sfOverlaps">
    <schema:name xml:lang="en">overlaps</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially overlaps the object SpatialObject. DE-9IM: T*T***T**</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#SpatialObjectCollection">
    <skos:note xml:lang="en">This is the superclass of Feature Collection and Geometry Collection.</skos:note>
    <schema:description xml:lang="en">A collection of individual Spatial Objects.</schema:description>
    <schema:name xml:lang="en">Spatial Object Collection</schema:name>
    <rdfs:subClassOf rdf:nodeID="A0"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Container"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/core/spatial-object-collection-class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#asGML">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.4"/>
    <schema:name xml:lang="en">as GML</schema:name>
    <schema:description xml:lang="en">The GML serialization of a Geometry</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geometry-as-gml-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/geometry-as-gml-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
