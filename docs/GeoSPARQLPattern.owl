    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#asDGGS">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.2.4"/>
    <schema:name xml:lang="en">as DGGS</schema:name>
    <schema:description xml:lang="en">The Discrete Global Grid System (DGGS) serialization of a Geometry</schema:description>
