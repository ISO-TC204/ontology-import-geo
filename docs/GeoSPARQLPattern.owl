<rdf:RDF
    xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
    xmlns:dcterms="http://purl.org/dc/terms/"
    xmlns:schema="https://schema.org/"
    xmlns:owl="http://www.w3.org/2002/07/owl#"
    xmlns:spec11="http://www.opengis.net/doc/IS/geosparql/1.1#"
    xmlns:skos="http://www.w3.org/2004/02/skos/core#"
    xmlns="http://www.opengis.net/ont/geosparql#"
    xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
    xmlns:vann="http://purl.org/vocab/vann/"
    xmlns:xsd="http://www.w3.org/2001/XMLSchema#" > 
  <rdf:Description rdf:nodeID="A0">
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#member"/>
    <owl:allValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#sfWithin">
    <schema:name xml:lang="en">within</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject is spatially within the object SpatialObject. DE-9IM: T*F**F***</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#GeometryCollection">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.7"/>
    <schema:name xml:lang="en">Geometry Collection</schema:name>
    <schema:description xml:lang="en">A collection of individual Geometries.</schema:description>
    <rdfs:subClassOf rdf:nodeID="A1"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObjectCollection"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/core/geometry-collection-class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#sfDisjoint">
    <schema:name xml:lang="en">disjoint</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject is spatially disjoint from the object SpatialObject. DE-9IM: FF*FF****</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <owl:equivalentProperty rdf:resource="http://www.opengis.net/ont/geosparql#ehDisjoint"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#geoJSONLiteral">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#c-1-2-4-%C2%A0-geometry-serializations"/>
    <schema:name xml:lang="en">GeoJSON Literal</schema:name>
    <schema:description xml:lang="en">A GeoJSON serialization of a Geometry object.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/geojson-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:seeAlso rdf:resource="https://tools.ietf.org/html/rfc7946"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#ehEquals">
    <schema:name xml:lang="en">equals</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially equals the object SpatialObject. DE-9IM: TFFFTFFFT</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <owl:equivalentProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfEquals"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#sfTouches">
    <schema:name xml:lang="en">touches</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially touches the object SpatialObject. DE-9IM: FT******* ^ F**T***** ^ F***T****</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/sf-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <owl:equivalentProperty rdf:resource="http://www.opengis.net/ont/geosparql#ehMeet"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#ehCoveredBy">
    <schema:name xml:lang="en">covered by</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject is spatially covered by the object SpatialObject. DE-9IM: TFF*TFT**</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#FeatureCollection">
    <skos:example rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#B.1.1.6"/>
    <schema:description xml:lang="en">A collection of individual Features.</schema:description>
    <schema:name xml:lang="en">Feature Collection</schema:name>
    <rdfs:subClassOf rdf:nodeID="A2"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObjectCollection"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/core/feature-collection-class"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#ehMeet">
    <schema:name xml:lang="en">meet</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject spatially meets the object SpatialObject. DE-9IM: FT******* ^ F**T***** ^ F***T****</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/eh-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#SpatialObject"/>
    <owl:equivalentProperty rdf:resource="http://www.opengis.net/ont/geosparql#sfTouches"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="A1">
    <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#member"/>
    <owl:allValuesFrom rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
