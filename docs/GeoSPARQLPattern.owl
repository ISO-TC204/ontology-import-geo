    <rdfs:seeAlso rdf:resource="http://www.opengis.net/doc/IS/geosparql/1.1#c-1-2-4-%C2%A0-geometry-serializations"/>
    <schema:description xml:lang="en">A Well-known Text serialization of a Geometry object.</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/geometry-extension/wkt-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/geometry-extension/wkt-literal"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql#"/>
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Datatype"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#rcc8ntpp">
    <schema:name xml:lang="en">non-tangential proper part</schema:name>
    <rdfs:seeAlso rdf:resource="http://dbpedia.org/resource/DE-9IM"/>
    <schema:description xml:lang="en">States that the subject SpatialObject is spatially inside the object SpatialObject. DE-9IM: TFFTFFTTT</schema:description>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.1/req/topology-vocab-extension/rcc8-spatial-relations"/>
    <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0/req/topology-vocab-extension/rcc8-spatial-relations"/>
